<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 213 — 받은 글 상자. 앱과 **같은** 앱 그룹이어야 앱이 꺼내 간다 (Shared/ShareInbox.swift).
	     애플 개발자 콘솔에 이 그룹을 등록하고, 이 확장의 App ID 에 연결해야 서명이 된다 (docs/06-ci.md). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.helpnara.markdown</string>
	</array>
</dict>
</plist>
